# StudyPilot AI - Environment Configuration Template
# Copy this file to .env and configure your backend values
# Never commit your actual .env file or API keys to Git

# Groq API Key (get yours from https://console.groq.com/keys)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Groq Model Identifier (recommended: llama-3.1-8b-instant or llama-3.3-70b-versatile)
GROQ_MODEL="openai/gpt-oss-20b"
